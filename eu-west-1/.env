# ~/.aws/config
# [profile condi.me_eu-west-1_admin]
# sso_start_url = https://d-9c67240387.awsapps.com/start
# sso_region = eu-west-2
# sso_account_id = 055237546114
# sso_role_name = AWSAdministratorAccess
# region = eu-west-1
export AWS_PROFILE=condi.me_eu-west-1_admin

# Login with SSO credentials to get an admin token
# This is managed by AWS SSO from the root account
# $ pass aws.amazon.com/d-9c67240387/bencord0
aws sso login

# Other environment variables
# export CONSUL_HTTP_TOKEN=...
. <(pass condi.me/terraform-plans)
